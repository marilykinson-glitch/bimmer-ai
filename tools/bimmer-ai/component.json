{
  "id": "bimmer-ai",
  "kind": "tool",
  "version": "0.6.1",
  "title": "Trợ lý AI Tiếng Việt (Bimmer AI)",
  "description": "Bộ não AI Tiếng Việt chạy trực tiếp trên đầu BMW MGU (iDrive 7): thu giọng nói theo yêu cầu từ cặp Mic trần zin 2 vùng & nút Mic vô-lăng, kết hợp xử lý lệnh tức thời Offline (<5ms) và Gemini Multimodal qua mgu-uplink. Điều khiển chuẩn SOME/IP điều hoà, đèn nội thất RGB, cửa kính, rèm, ghế, YouTube TV (RideTube), đề nổ 1CR (Bimmer-Link), VietMap và chốt chặn an toàn cứng.",
  "license": "GPL-3.0-or-later",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11",
    "mgu-python": "1.0.2"
  },
  "files": [
    {
      "path": "bimmer-ai.js",
      "mode": "0644"
    },
    {
      "path": "safety-gate.js",
      "mode": "0644"
    },
    {
      "path": "vehicle-bus.js",
      "mode": "0644"
    },
    {
      "path": "audio-io.js",
      "mode": "0644"
    },
    {
      "path": "alsa-smartx.py",
      "mode": "0755"
    },
    {
      "path": "ai-brain.js",
      "mode": "0644"
    },
    {
      "path": "uplink.js",
      "mode": "0644"
    },
    {
      "path": "page.html",
      "mode": "0644"
    },
    {
      "path": "LICENSE.GPL-3.0",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bimmer-ai.service"
    }
  ],
  "enable": [
    {
      "unit": "bimmer-ai.service",
      "target": "oapcontroller.service"
    }
  ],
  "recmgr": [
    "bimmer-ai"
  ],
  "restart": [
    "bimmer-ai.service"
  ],
  "deactivate": [
    "node",
    "bimmer-ai.js",
    "fwclose"
  ],
  "internet": true,
  "uids": "state/internet-uids"
}
