{
  "id": "bimmer-ai",
  "kind": "tool",
  "version": "0.6.0",
  "title": "Trợ lý AI Tiếng Việt & Pô B&W ASD (Bimmer AI)",
  "description": "Bộ não AI Tiếng Việt & Bộ tổng hợp Âm thanh Ống xả Bowers & Wilkins (6 động cơ ăn theo chế độ lái Sport/Comfort/Eco Pro) chạy trực tiếp trên đầu BMW MGU (iDrive 7): thu giọng nói từ Mic trần zin 2 vùng & nút vô-lăng, xử lý Offline (<5ms) + Gemini Multimodal, phát pô B&W kênh Overlay không ngắt nhạc CarPlay, điều khiển điều hoà, đèn RGB, kính, rèm, ghế, YouTube TV và đọc lỗi xe.",
  "license": "GPL-3.0-or-later",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11",
    "mgu-python": "1.0.2"
  },
  "files": [
    {
      "path": "bimmer-ai.js",
      "mode": "0644"
    },
    {
      "path": "safety-gate.js",
      "mode": "0644"
    },
    {
      "path": "vehicle-bus.js",
      "mode": "0644"
    },
    {
      "path": "audio-io.js",
      "mode": "0644"
    },
    {
      "path": "asd-synth.js",
      "mode": "0644"
    },
    {
      "path": "alsa-smartx.py",
      "mode": "0755"
    },
    {
      "path": "ai-brain.js",
      "mode": "0644"
    },
    {
      "path": "uplink.js",
      "mode": "0644"
    },
    {
      "path": "page.html",
      "mode": "0644"
    },
    {
      "path": "LICENSE.GPL-3.0",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bimmer-ai.service"
    }
  ],
  "enable": [
    {
      "unit": "bimmer-ai.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "bimmer-ai"
  ],
  "restart": [
    "bimmer-ai.service"
  ],
  "internet": true,
  "uids": "state/internet-uids"
}
